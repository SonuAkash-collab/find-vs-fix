.venv/
__pycache__/
*.pyc
.python-version
# data: keep only the manifest
data/*
!data/manifest.json
# wrong-label data: keep only the manifest
data_wronglabel/*
!data_wronglabel/manifest.json
# model weights and caches
runs/**/*.pt
runs/**/*.safetensors
runs/**/*.bin
runs/**/model/
runs/**/retrain_saved/
.cache/
hf_cache/
logs/*.pid
logs/*.stdout.txt
logs/*.stderr.txt

share/
*.zip

# Pythia training checkpoints and outputs
runs_pythia/

# Pythia dataset files are regenerated; commit only the manifest
data_pythia/*
!data_pythia/manifest.json

# model folders inside result folders are never committed
results/**/model/

# Phase 3c no-names data is regenerated (src/make_nonames.py); commit only the manifest
data_nonames/*
!data_nonames/manifest.json

# Phase 5 word-cue data is regenerated (src/make_wordcue.py); commit only the manifest
data_wordcue/*
!data_wordcue/manifest.json

# Phase L6 weak-name data is regenerated (src/make_weak.py); commit only the manifests
data_weak_p*/*
!data_weak_p*/manifest.json
